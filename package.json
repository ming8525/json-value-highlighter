{
  "name": "json-value-highlighter",
  "displayName": "JSON highlighter",
  "description": "Automatically mark the ref palette variable and classic theme variable in jimu-theme. You can customize the json value to be marked by modifying jsonHighlighter.patterns.",
  "version": "0.0.1",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "publisher": "ming8525",
  "repository": "https://github.com/ming8525/json-value-highlighter",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json"
  ],
  "main": "./dist/index.js",
  "contributes": {
    "commands": [
      {
        "command": "json-value-highlighter.helloWorld",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "title": "JSON Highlighter",
      "properties": {
        "jsonHighlighter.patterns": {
          "type": "array",
          "description": "Array of regex pattern rules to match JSON values and show custom hover messages.",
          "default": [
            {
              "pattern": ":\\s*\"(var\\(--\\b(primary|secondary|danger|warning|info|success|white|black|light|dark|transparent)(?:-(100|200|300|400|500|600|700|800|900))?\\))\"",
              "message": "'Classic theme css variables should not be used, please use the `--sys-color` css vars instead.'"
            },
            {
              "pattern": ":\\s*\"(var\\(--ref-palette-(primary|secondary|neutral|error|warning|info|success)-(100|200|300|400|500|600|700|800|900|1000|1100|1200|1300)\\))\"",
              "message": "'Theme `--ref-palette` css vars should not be used, please use the `--sys-color` css vars instead.'"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regex pattern to match (must have a capture group for value)",
                "default": ""
              },
              "message": {
                "type": "string",
                "description": "Hover message when match occurs",
                "default": ""
              }
            },
            "required": [
              "pattern"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "package": "vsce package -o dist"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "vsce": "^2.15.0"
  }
}